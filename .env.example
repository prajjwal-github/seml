# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=securewipe
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/securewipe

# Application configuration - MUST BE 'simulation'
WIPE_MODE=simulation

# Security configuration
JWT_SECRET=super-secret-wipe-jwt-key-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Simulation & Approval parameters
APPROVAL_EXPIRY_HOURS=24
SIM_FAILURE_RATE=0.0
SIM_PASS_SLEEP_MS=200

# CORS settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
